{
  "rules": {
    "registrationCodes": {
      ".read": true,
      "$code": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "teacherJoinCodes": {
      ".read": true,
      "$code": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "pendingRegistrations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "userMeta": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('schools').child(newData.child('schoolId').val()).child('admins').child(auth.uid).exists() || (data.exists() && root.child('schools').child(data.child('schoolId').val()).child('admins').child(auth.uid).exists()))"
      }
    },

    "devices": {
      ".read": "auth != null",
      "$mac": {
        ".read": "auth != null",
        ".write": "auth != null",
        "schoolId": { ".write": "auth != null" },
        "classId": { ".write": "auth != null" },
        "label": { ".write": "auth != null" },
        "presence": { ".write": "auth != null" },
        "scans": { ".write": "auth != null" },
        "responses": { ".read": "auth != null", ".write": "auth != null" },
        "enrollCommand": { ".read": "auth != null", ".write": "auth != null" },
        "logs": { ".read": "auth != null", ".write": "auth != null" }
      }
    },

    "schools": {
      "$sid": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() && newData.child('admins').child(auth.uid).val() === true || data.child('admins').child(auth.uid).exists())",
        
        "admins": {
          ".read": true,
          ".write": "auth != null && data.parent().child('admins').child(auth.uid).exists()"
        },

        "profile": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('schools').child($sid).child('admins').child(auth.uid).exists()"
        },

        "teachers": {
          ".read": "auth != null",
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $uid || root.child('schools').child($sid).child('admins').child(auth.uid).exists())"
          }
        },

        "students": {
          ".read": "auth != null",
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $uid || root.child('schools').child($sid).child('admins').child(auth.uid).exists() || root.child('schools').child($sid).child('teachers').child(auth.uid).exists())"
          }
        },

        "classes": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('schools').child($sid).child('admins').child(auth.uid).exists()",
          "$cid": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('schools').child($sid).child('admins').child(auth.uid).exists() || data.child('teacherUids').child(auth.uid).exists() || data.child('teacherUid').val() === auth.uid)",
            "students": {
              ".write": "auth != null"
            },
            "teacherUids": {
              ".write": "auth != null"
            },
            "sessions": {
              ".write": "auth != null"
            }
          }
        },

        "attendance": {
          ".read": "auth != null",
          "$cid": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('schools').child($sid).child('admins').child(auth.uid).exists() || root.child('schools').child($sid).child('classes').child($cid).child('teacherUids').child(auth.uid).exists() || root.child('schools').child($sid).child('classes').child($cid).child('teacherUid').val() === auth.uid)"
          }
        },

        "entryLogs": {
          ".read": "auth != null",
          "$cid": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },

    "_meta": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}